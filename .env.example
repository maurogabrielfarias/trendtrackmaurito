# ---------- Claude dentro de la app (pestaña "Claude IA") ----------
# Tu API key de Anthropic (https://platform.claude.com/settings/keys).
# Cada búsqueda consume los créditos de esa cuenta. También puedes pegarla en "Ajustes".
ANTHROPIC_API_KEY=
# Modelo: claude-opus-5-5 (recomendado) o claude-sonnet-5-5 (más barato)
CLAUDE_MODEL=claude-opus-5-5

# ---------- Servidor MCP por HTTP (/mcp) ----------
# Obligatorio si publicas la app en internet o la expones con un túnel.
MCP_TOKEN=

# ---------- Anuncios ----------
# Opcional: token de la Meta Ad Library API (https://www.facebook.com/ads/library/api)
META_ACCESS_TOKEN=
# País (UE/UK) para contar los anuncios activos de cada tienda
META_ADS_COUNTRY=ES

# ---------- Servidor web ----------
PORT=3000
# 127.0.0.1 = solo tu ordenador. Usa 0.0.0.0 para publicarla (¡con APP_PASSWORD y MCP_TOKEN!)
HOST=127.0.0.1
# Contraseña para la interfaz web (usuario: cualquiera)
APP_PASSWORD=
# Cada cuántas horas se re-escanean las tiendas (0 = nunca)
RESCAN_HOURS=24
